FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:/app/backend

COPY backend/requirements.txt backend/requirements-ml.txt /app/backend/

RUN pip install --no-cache-dir -r /app/backend/requirements.txt \
    && pip install --no-cache-dir -r /app/backend/requirements-ml.txt

COPY backend/ /app/backend/
COPY ml/ /app/ml/
COPY backend/start-production.sh /app/backend/start-production.sh

RUN chmod +x /app/backend/start-production.sh

WORKDIR /app/backend

EXPOSE 8000

CMD ["sh", "/app/backend/start-production.sh"]
