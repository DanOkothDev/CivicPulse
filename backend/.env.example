FLASK_DEBUG=1
# Set to production in Azure Container Apps to enable startup validation.
CIVICPULSE_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
DATABASE_URL=postgresql+psycopg2://civicpulse:civicpulse@localhost:5432/civicpulse
REDIS_URL=redis://localhost:6379/0
UPLOAD_FOLDER=uploads
CORS_ORIGINS=http://localhost:5173
# Gmail: enable 2-Step Verification, create an App Password, and use that value
# as SMTP_PASSWORD. Use the mailbox address for SMTP_USERNAME and FROM_EMAIL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_USE_SSL=false
QUEUE_MODE=redis
QUEUE_NAME=default
AI_CLASSIFIER=
AI_DUPLICATES=ml.duplicates.detector:find_duplicates
INSTALL_ML=
